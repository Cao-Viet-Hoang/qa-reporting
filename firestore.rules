rules_version = '2';

// PLAN.md §1: rules are open permanently (NOT "test mode", which locks itself after 30 days).
// WARNING: anyone who knows the project id + API key can read and write ALL data.
// The access screen in the app is not a security boundary. See README.md "Bảo mật & rủi ro".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
